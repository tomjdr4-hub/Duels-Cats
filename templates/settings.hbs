<div class="duels-cats-settings">
  <p class="dc-hint">{{localize "DUELSCATS.SettingsHint"}}</p>

  {{#if hasActors}}
  <div class="form-group dc-inspect">
    <label>{{localize "DUELSCATS.InspectLabel"}}</label>
    <p class="dc-hint">{{localize "DUELSCATS.InspectHint"}}</p>
    <div class="dc-sound-row">
      <select name="inspectActorId">
        {{#each actors}}
        <option value="{{this.id}}">{{this.name}}</option>
        {{/each}}
      </select>
      <button type="button" data-action="inspectActor"><i class="fa-solid fa-magnifying-glass"></i> {{localize "DUELSCATS.InspectButton"}}</button>
    </div>
    <pre class="dc-inspect-output" hidden></pre>
  </div>
  <hr />
  {{/if}}

  <div class="form-group">
    <label>{{localize "DUELSCATS.PathCoussinet"}}</label>
    <input type="text" name="coussinet" value="{{paths.coussinet}}" />
  </div>
  <div class="form-group">
    <label>{{localize "DUELSCATS.PathCaresse"}}</label>
    <input type="text" name="caresse" value="{{paths.caresse}}" />
  </div>
  <div class="form-group">
    <label>{{localize "DUELSCATS.PathReputation"}}</label>
    <input type="text" name="reputation" value="{{paths.reputation}}" />
  </div>
  <div class="form-group">
    <label>{{localize "DUELSCATS.HissSound"}}</label>
    <div class="dc-sound-row">
      <input type="text" name="hissSound" value="{{hissSound}}" readonly />
      <button type="button" data-action="browseSound"><i class="fa-solid fa-folder-open"></i></button>
      <button type="button" data-action="clearSound"><i class="fa-solid fa-xmark"></i></button>
    </div>
  </div>

  <footer class="dc-settings-actions">
    <button type="button" data-action="save"><i class="fa-solid fa-check"></i> {{localize "DUELSCATS.Save"}}</button>
  </footer>
</div>
